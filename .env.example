# slack-mcp-server reads its Slack user token from the environment at runtime.
# With inscope, the chpwd hook exports this per workspace ($PWD); otherwise set it yourself.

# User OAuth token (xoxp-...). Create the app from manifest.full.json or
# manifest.readonly.json, install it, and copy the "User OAuth Token".
SLACK_MCP_XOXP_TOKEN=

# Optional: write tools are on by default. Set "false" (or "0") to expose only
# the read-only tools; any value other than "true"/"1" also turns writes off.
# SLACK_MCP_ALLOW_WRITE=false

# Optional: name-resolution cache (lets tools accept #channel / @handle).
#   SLACK_MCP_CACHE_TTL   seconds before users/channels are re-fetched (default 86400)
#   SLACK_MCP_CACHE_DIR   override the on-disk cache location (default ~/.cache/slack-mcp-server)
# SLACK_MCP_CACHE_TTL=86400
